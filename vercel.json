{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash ./vercel-build.sh",
  "outputDirectory": "build/web",
  "installCommand": "",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
